# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Postgres / Meilisearch
POSTGRES_PASSWORD=premier
MEILI_MASTER_KEY=dev-meili-master-key

# Next.js <-> Django on-demand revalidation (same value on both sides)
REVALIDATE_SECRET=dev-revalidate-secret
# Production: set this to the public HTTPS origin before launch (canonical URLs, sitemap and robots.txt).
SITE_URL=http://localhost:8080

# Optional integrations (leave empty to disable)
NOVA_POSHTA_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MANAGER_EMAILS=support@premier-parts.com.ua

# Mirohost SMTP for verification codes, password resets, and order notices.
# Set EMAIL_HOST_PASSWORD only in the private .env or a deployment secret store.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=Premier Parts <support@premier-parts.com.ua>
EMAIL_HOST=mx1.mirohost.net
EMAIL_PORT=587
EMAIL_HOST_USER=support@premier-parts.com.ua
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=10

# OAuth redirect URIs: ${SITE_URL}/api/account/oauth/{google|apple}/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_SERVICE_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Enable when SITE_URL uses HTTPS (required for production sessions and Apple sign-in).
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Forma B2B. Obtain exact tree/image URLs from a verified Network trace.
# Add credentials only to the private .env or the deployment secret store.
FORMA_API_BASE_URL=https://ecom.ad.ua
FORMA_B2B_TOKEN=
FORMA_CATEGORY_TREE_URL=
FORMA_CATEGORY_TREE_METHOD=GET
FORMA_CATEGORY_TREE_BODY=
FORMA_IMAGE_BASE_URL=
FORMA_SYNC_CONCURRENCY=5
FORMA_SYNC_DELAY=0.2
FORMA_SYNC_BATCH_SIZE=200
FORMA_AUTOSYNC=false
FORMA_FAST_INTERVAL_HOURS=4
FORMA_FULL_INTERVAL_HOURS=24
FORMA_STALE_JOB_HOURS=6
